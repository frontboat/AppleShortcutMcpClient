{
  "name": "apple-shortcut-mcp-client",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.mts",
    "check": "tsc --noEmit --module nodenext --target es2022 --skipLibCheck --allowImportingTsExtensions scripts/build.mts src/*.mts tests/*.ts",
    "test": "bun test tests",
    "build:labs": "bun examples/display/build.mts",
    "generate:static": "bun archive/static/mcp-to-shortcut.mts"
  },
  "dependencies": {
    "shortcutkit": "3.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
